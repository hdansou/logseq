   "/*@import \"https://codemirror.net/theme/blackboard.css\";*/\n@import \"https://codemirror.net/5/theme/solarized.css\";\n@import \"https://codemirror.net/5/theme/monokai.css\";\n@import \"https://codemirror.net/5/theme/idea.css\";\n@import \"https://codemirror.net/5/theme/lucario.css\";\n@import \"https://codemirror.net/5/theme/yonce.css\";\n@import \"https://codemirror.net/5/theme/seti.css\";\n@import \"https://codemirror.net/5/theme/midnight.css\";\n\n@font-face {\n    font-family: 'OpenDyslexic';\n    src: url('/static/css/fonts/OpenDyslexic-Regular.otf') format('opentype'), url('/static/css/fonts/OpenDyslexic-Bold.otf') format('opentype'), url('/static/css/fonts/OpenDyslexic-Italic.otf') format('opentype'), url('/static/css/fonts/OpenDyslexic-BoldItalic.otf') format('opentype');\n    font-display: swap;\n}\n\n@font-face {\n    font-family: 'tabler-icons';\n    src: url('/static/css/fonts/tabler-icons.eot');\n    src: url('/static/css/fonts/tabler-icons.eot?#iefix') format('embedded-opentype'),\n         url('/static/css/fonts/tabler-icons.woff2') format('woff2'),\n         url('/static/css/fonts/tabler-icons.woff') format('woff'),\n         url('/static/css/fonts/tabler-icons.ttf') format('truetype'),\n         url('/static/css/fonts/tabler-icons.svg#tabler-icons') format('svg');\n}\n@font-face {\n  font-family: 'tabler-icons-extension';\n  src: url('/static/css/fonts/tabler-icons-extension.woff2?mxgthk') format('woff2');\n}\n\n\n:root{\n\t--ls-font-family: \"Shantell Sans\",\"tabler-icons\",\"AtkinsonHyperlegibleNext-Regular\",\"UbuntuMono Nerd Font Mono\",\"Atkinson Hyperlegible Mono\", \"AtkinsonHyperlegibleNext-Regular_Light\",\"AtkinsonHyperlegibleMono-ExtraLight_Regular\",\"Atkinson Hyperlegible Next\",\"AtkinsonHyperlegibleNext-Regular_Light\",\"American Typewriter\",\"Chalkduster\",\"OpenDyslexic Nerd Font\",\"Noteworthy\",\"JetBrainsMonoNL Nerd Font\",\"Source Code Pro for Powerline\",\"PT Mono\",\"OpenDyslexic Nerd Font\",\"Noteworthy\",\"Chalkduster\",\"Cascadia code\",\"American Typewriter\",\"Inter\";\n}\n.aspect-video {\n    aspect-ratio: 16/9;\n    width: 100%;\n    height: auto;\n}\n\n.ls-table .ls-table-row {\n    height: fit-content;\n    max-height: 240px;\n    min-height: 18px;\n}\n\n.ls-table .ls-table-row a, .ls-table .ls-table-row div, .ls-table .ls-table-row span {\n    white-space: inherit;\n}\n\n/* css kanban view v20241222 \n\n.ls-block:has([data-ref*=\"v.-kanban\"]) > .block-children-container.flex > .block-children > div.blocks-list-wrap > .ls-block {\n\tdisplay: inline-block;\n\tmin-width: 150px;\n    max-width: 400px;\n    width: auto;\n    vertical-align: top\n}\n\n.ls-block:has([data-ref*=\"v.-kanban\"]) > .block-children-container.flex > .block-children > div.blocks-list-wrap {\n    text-wrap-mode: nowrap;\n}\n/* CSS for two-column outline */\n\n/* Parent .ls-block with v.-tree-table reference */\n.ls-block:has([data-ref*=\"v.-tree-table\"]) {\n    display: flex;\n    flex-direction: row;\n    align-items: flex-start;\n}\n*/\n/* Fix Fenced Code Plugin image size */\n.block-content-wrapper svg, .view-actions svg {\n    height: auto;\n    width: auto;\n}\n.katex-html {text-align: left;}",
