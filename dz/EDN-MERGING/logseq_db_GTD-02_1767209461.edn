    {:block/title "## Managing Context with Tool Calling",
     :block/created-at 1761790357675,
     :block/updated-at 1761790357675,
     :build/properties {:logseq.property/heading 2},
     :build/children
     [{:block/title "### Best Practices for Tool Design",
       :block/created-at 1761790357675,
       :block/updated-at 1761790357675,
       :build/properties {:logseq.property/heading 3},
       :build/children
       [{:block/title "1. Single Responsibility",
         :block/created-at 1761790357675,
         :block/updated-at 1761790625729,
         :build/properties {:logseq.property/heading 4},
         :build/children
         [{:block/title "Each tool should do one thing well",
           :block/created-at 1761790625737,
           :block/updated-at 1761790626473,
           :build/properties {},
           :build/children
           [{:block/title
             "```typescript\n// Good: Specific, focused tool\n{ name: \"search_documents\", description: \"Search through documents\" }\n\n// Avoid: Overly broad tool\n{ name: \"do_everything\", description: \"Handle all operations\" }\n```",
             :block/created-at 1761790626481,
             :block/updated-at 1761790626481,
             :build/properties {}}]}]}]}]}
    {:block/title "2. Clear Input Schemas",
     :block/created-at 1761790357675,
     :block/updated-at 1761790635363,
     :build/properties {:logseq.property/heading 4},
     :build/children
     [{:block/title "Use JSON Schema to define precise parameters",
       :block/created-at 1761790635373,
       :block/updated-at 1761790636898,
       :build/properties {},
       :build/children
       [{:block/title
         "```typescript\ninputSchema: {\ntype: \"object\",\nproperties: {\n  query: { \n    type: \"string\", \n    description: \"Search query terms\" \n  },\n  limit: { \n    type: \"number\", \n    default: 10,\n    description: \"Maximum results to return\"\n  }\n},\nrequired: [\"query\"]\n}\n```",
         :block/created-at 1761790636906,
         :block/updated-at 1761790636906,
         :build/properties {}}]}]}
    {:block/title "3. Rich Output Formats",
     :block/created-at 1761790357675,
     :block/updated-at 1761790643047,
     :build/properties {:logseq.property/heading 4},
     :build/children
     [{:block/title "Return structured data the LLM can understand",
       :block/created-at 1761790643055,
       :block/updated-at 1761790645133,
       :build/properties {},
       :build/children
       [{:block/title
         "```typescript\nreturn {\ncontent: [\n  {\n    type: \"text\",\n    text: JSON.stringify(results, null, 2)\n  },\n  {\n    type: \"resource\",\n    resource: {\n      uri: \"file:///path/to/result.json\",\n      mimeType: \"application/json\"\n    }\n  }\n]\n};\n```",
         :block/created-at 1761790645142,
         :block/updated-at 1761790645142,
         :build/properties {}}]}]}
