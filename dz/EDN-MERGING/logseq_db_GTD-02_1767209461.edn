    :block/title "Model Context Protocol (MCP) Study Guide"},
   :blocks
   [{:block/title "Overview of MCP",
     :block/created-at 1761790357675,
     :block/updated-at 1761790365850,
     :build/properties {:logseq.property/heading 2},
     :build/children
     [{:block/title
       "Model Context Protocol (MCP) is an open protocol developed by Anthropic that standardizes how applications provide context to Large Language Models (LLMs). It creates a universal connection layer between AI systems and external data sources, tools, and services.",
       :block/created-at 1761790365859,
       :block/updated-at 1761790365859,
       :build/properties {}}]}
    {:block/title "### Key Benefits",
     :block/created-at 1761790357675,
     :block/updated-at 1761790357675,
     :build/properties {:logseq.property/heading 3},
     :build/children
     [{:block/title
       "**Standardization**: One protocol for connecting LLMs to multiple data sources",
       :block/created-at 1761790357675,
       :block/updated-at 1761790357675,
       :build/properties {}}
      {:block/title
       "**Modularity**: Build once, use with any MCP-compatible client",
       :block/created-at 1761790357675,
       :block/updated-at 1761790357675,
       :build/properties {}}
      {:block/title
       "**Security**: Controlled access to resources through well-defined interfaces",
       :block/created-at 1761790357675,
       :block/updated-at 1761790357675,
       :build/properties {}}
      {:block/title
       "**Flexibility**: Works with local files, databases, APIs, and more",
       :block/created-at 1761790357675,
       :block/updated-at 1761790377063,
       :build/properties {}}
      {:block/title "---",
       :block/created-at 1761790377076,
       :block/updated-at 1761790377076,
       :build/properties {}}]}
