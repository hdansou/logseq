  :doc "429 retry-after seconds"}
 {:symbol reconnect-base-delay-ms :file "src/main/frontend/worker/sync.cljs" :expected 1000 :doc "ws reconnect base"}
 {:symbol reconnect-max-delay-ms :file "src/main/frontend/worker/sync.cljs" :expected 30000 :doc "ws reconnect max"}
