 {:symbol ws-stale-kill-interval-ms :file "src/main/frontend/worker/sync.cljs" :expected 60000 :doc "stale ws check interval"}
 {:symbol ws-stale-timeout-ms :file "src/main/frontend/worker/sync.cljs" :expected 600000 :doc "stale ws timeout"}
 {:symbol upload-response-timeout-ms :file "src/main/frontend/worker/sync/apply_txs.cljs" :expected 120000 :doc "upload response timeout"}
 {:symbol max-remote-apply-snapshot-retries :file "src/main/frontend/worker/sync/apply_txs.cljs" :expected 3 :doc "snapshot apply retries"}
 {:symbol remote-apply-snapshot-retry-delay-ms :file "src/main/frontend/worker/sync/apply_txs.cljs" :expected 50 :doc "snapshot apply retry delay"}

