 {:symbol snapshot-import-datoms-batch-size :file "src/main/frontend/worker/sync/download.cljs" :expected 10000 :doc "datoms per import batch"}
 {:symbol remote-asset-download-parallelism :file "src/main/frontend/worker/sync/assets.cljs" :expected 10 :doc "concurrent asset downloads"}
 {:symbol max-sql-params :file "deps/db-sync/src/logseq/db_sync/batch.cljs" :expected 99 :doc "sql bind params per statement"}
